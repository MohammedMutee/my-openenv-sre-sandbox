# ──────────────────────────────────────────────────────────────
# SRE Sandbox Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────

# ── LLM Agent ─────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ── Docker ────────────────────────────────────────────────────
DOCKER_IMAGE=sre-sandbox
CONTAINER_STARTUP_WAIT=2.0

# ── Evaluation ────────────────────────────────────────────────
MAX_STEPS=10
AGENT_TYPE=mock

# ── Reward Weights ────────────────────────────────────────────
REWARD_LOG_INVESTIGATION=0.2
REWARD_SERVICE_RESTART=0.3
REWARD_TASK_SOLVED=0.5
REWARD_PHASE_BONUS=0.1
PENALTY_DESTRUCTIVE_CMD=-1.0
PENALTY_BLOCKED_CMD=-0.5

# ── Paths ─────────────────────────────────────────────────────
RESULTS_DIR=results
